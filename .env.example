# Copy this to .env and adjust as needed.
# All VITE_ variables are embedded at build time (visible in the browser bundle).
# Do not put secrets here.

# Override the Ollama endpoint baked into the build.
# During `npm run dev` the Vite proxy rewrites /ollama-proxy → this value.
# In production you'll need a real endpoint if you want AI features.
VITE_OLLAMA_ENDPOINT=http://localhost:11434
